# Copy to .env and fill in. .env is ignored by git.
AIRFLOW_UID=50000

# Warehouse database (where the job data lives)
WAREHOUSE_USER=jobs
WAREHOUSE_PASSWORD=change-me
WAREHOUSE_DB=jobs

# Airflow web UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# MyCareersFuture: how many pages of 100 postings to fetch per run (0 = all)
MCF_MAX_PAGES=0

# Near-real-time feed (mcf_live_poll DAG): pages of 100 newest postings per 30-minute poll
MCF_LIVE_PAGES=3

# Adzuna backup source (only needed if MyCareersFuture access fails)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
